if(CMAKE_SCRIPT_MODE_FILE)
	# file(STRINGS) joins lines around an unbalanced `[`, which dump names carry (`[cr SR]`), so
	# the file is read whole and split by hand.
	file(READ "${IN}" _text)
	string(REPLACE "\r" "" _text "${_text}")
	set(_rows "")
	set(_count 0)
	while(1)
		if("${_text}" STREQUAL "")
			break()
		endif()
		string(FIND "${_text}" "\n" _nl)
		if(_nl EQUAL -1)
			set(_line "${_text}")
			set(_text "")
		else()
			string(SUBSTRING "${_text}" 0 ${_nl} _line)
			math(EXPR _next "${_nl} + 1")
			string(SUBSTRING "${_text}" ${_next} -1 _text)
		endif()
		string(FIND "${_line}" "#" _hash)
		if(NOT _hash EQUAL -1)
			string(SUBSTRING "${_line}" 0 ${_hash} _line)
		endif()
		string(STRIP "${_line}" _line)
		if("${_line}" STREQUAL "")
			continue()
		endif()
		set(_hex "[0-9A-Fa-f]")
		if(NOT _line MATCHES "^(${_hex}${_hex}${_hex}${_hex}${_hex}${_hex}${_hex}${_hex})[ \t]+([a-z0-9_]+)[ \t]+(verified|known|refused)[ \t]+(.*[^ \t])$")
			message(FATAL_ERROR "${IN}: cannot parse `${_line}`")
		endif()
		string(TOLOWER "${CMAKE_MATCH_1}" _crc)
		set(_role "${CMAKE_MATCH_2}")
		set(_status "${CMAKE_MATCH_3}")
		set(_name "${CMAKE_MATCH_4}")
		string(SUBSTRING "${_status}" 0 1 _first)
		string(TOUPPER "${_first}" _first)
		string(SUBSTRING "${_status}" 1 -1 _rest)
		string(REPLACE "\\" "\\\\" _name "${_name}")
		string(REPLACE "\"" "\\\"" _name "${_name}")
		string(APPEND _rows "\t{0x${_crc}u, \"${_role}\", SdlDumpStatus${_first}${_rest}, \"${_name}\"},\n")
		math(EXPR _count "${_count} + 1")
	endwhile()
	file(WRITE "${OUT}"
		"#include \"image.h\"\n\n"
		"const struct SdlDump sdl_dumps[] = {\n${_rows}\t{0, 0, SdlDumpStatusKnown, 0}\n};\n"
		"const uint32_t sdl_dump_count = ${_count};\n")
else()
	function(amiga_dumps in out)
		add_custom_command(
			OUTPUT "${out}"
			COMMAND "${CMAKE_COMMAND}" -DIN=${in} -DOUT=${out} -P "${AMIGA_ROOT}/cmake/dumps.cmake"
			DEPENDS "${in}" "${AMIGA_ROOT}/cmake/dumps.cmake"
			VERBATIM)
	endfunction()
endif()
