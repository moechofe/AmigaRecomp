body, div, h1, h2, p
{
	display: block;
}

body
{
	font-family: LatoLatin;
	font-size: 16dp;
	color: #e0e0e0;
	width: 100%;
	height: 100%;
	word-break: break-word;
}

#top
{
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
}

#banner
{
	padding: 8dp 16dp;
	background-color: #202020f0;
}

#welcome
{
	width: 320dp;
	margin: 12dp;
	padding: 12dp 16dp;
	box-sizing: border-box;
	border: 1dp #606060;
	border-radius: 6dp;
	background-color: #202020f0;
	font-size: 15dp;
}

#welcome h2
{
	margin-top: 0;
}

#welcome .row
{
	display: flex;
	margin-top: 4dp;
}

#welcome .row span
{
	flex: 1 1 auto;
}

#welcome .row .label
{
	flex: 0 0 90dp;
}

#welcome .foot
{
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-top: 12dp;
}

#welcome .foot button
{
	margin: 0;
	padding: 4dp 14dp;
}

input.checkbox
{
	width: 14dp;
	height: 14dp;
	margin-right: 8dp;
	vertical-align: middle;
	border: 1dp #808080;
	background-color: #303030;
}

input.checkbox:checked
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
}

#panel
{
	position: absolute;
	top: 24dp;
	left: 50%;
	width: 600dp;
	margin-left: -300dp;
	bottom: 24dp;
	box-sizing: border-box;
	padding: 20dp;
	background-color: #202020f0;
}

h1
{
	font-size: 24dp;
	font-weight: bold;
	margin-bottom: 8dp;
}

h2
{
	font-size: 18dp;
	font-weight: bold;
	margin-top: 16dp;
	margin-bottom: 8dp;
}

.disk
{
	display: block;
	margin-bottom: 8dp;
}

.label
{
	display: inline-block;
	vertical-align: top;
	width: 100dp;
	font-weight: bold;
}

.underline
{
	text-decoration: underline;
}

.state
{
	display: inline-block;
	vertical-align: top;
	width: 436dp;
}

.source
{
	display: block;
	margin-left: 100dp;
	font-size: 13dp;
	color: #a0a0a0;
}

p
{
	margin-top: 8dp;
}

.message
{
	color: #c0c0a0;
}

button
{
	display: inline-block;
	margin-top: 16dp;
	margin-right: 8dp;
	padding: 6dp 16dp;
	border: 1dp #808080;
	background-color: #303030;
	color: #e0e0e0;
}

button:hover
{
	background-color: #505050;
	border-color: #ffffff;
}

.option
{
	display: block;
	margin-bottom: 8dp;
}

.name
{
	display: inline-block;
	width: 356dp;
	font-weight: bold;
}

.hint
{
	display: block;
	font-size: 13dp;
	color: #a0a0a0;
}

.option.mismatch
{
	color: #808080;
}

button.chosen
{
	border-color: #ffffff;
}

.toggle
{
	display: inline-block;
}

.toggle button
{
	margin-right: 0;
	padding: 6dp 12dp;
}

.toggle button.chosen
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
}

.toggle button.chosen:hover
{
	background-color: #ffffff;
	border-color: #ffffff;
}

#head
{
	height: 72dp;
}

#head h1
{
	margin-right: 140dp;
}

#resume
{
	position: absolute;
	top: 20dp;
	right: 20dp;
	margin: 0;
	padding: 4dp 14dp;
	border-radius: 14dp;
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
}

#resume:hover
{
	background-color: #ffffff;
	border-color: #ffffff;
}

#resume .cap
{
	font-weight: bold;
	margin-right: 8dp;
}

#nav button
{
	margin-top: 0;
	margin-right: 6dp;
	padding: 4dp 14dp;
	border: 1dp #606060;
	border-radius: 14dp;
	background-color: transparent;
	color: #c0c0c0;
}

#nav button:hover
{
	border-color: #ffffff;
	color: #ffffff;
	background-color: transparent;
}

#nav button.current
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
}

#page
{
	position: absolute;
	top: 104dp;
	bottom: 20dp;
	left: 20dp;
	right: 20dp;
	padding-right: 24dp;
	overflow-y: auto;
}

scrollbarvertical
{
	width: 8dp;
}

scrollbarvertical slidertrack
{
	width: 8dp;
	background-color: #ffffff14;
	border-radius: 4dp;
}

scrollbarvertical sliderbar
{
	width: 8dp;
	min-height: 24dp;
	background-color: #ffffff60;
	border-radius: 4dp;
}

scrollbarvertical sliderbar:hover
{
	background-color: #ffffffa0;
}

.lead
{
	font-size: 18dp;
	margin-top: 0;
}

.actions
{
	display: block;
	margin-bottom: 8dp;
}

button.primary
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
	font-weight: bold;
}

button.primary:hover
{
	background-color: #ffffff;
	border-color: #ffffff;
}

.key
{
	display: block;
	margin-bottom: 4dp;
}

.disk button
{
	margin-left: 100dp;
	margin-top: 6dp;
}

.disk .hint
{
	margin-left: 100dp;
}

.drive
{
	display: block;
	margin-bottom: 8dp;
}

.drive .label
{
	padding-top: 7dp;
}

.drive .state
{
	padding-top: 7dp;
}

.drive button
{
	margin-top: 0;
}

.command
{
	display: block;
	margin-bottom: 4dp;
}

.command .label
{
	width: 130dp;
	padding-top: 7dp;
}

.keys
{
	display: inline-block;
	vertical-align: top;
	width: 400dp;
}

.keys button
{
	margin-top: 0;
	margin-bottom: 4dp;
}

.keycap .remove
{
	margin-left: 8dp;
	color: #a0a0a0;
}

.waiting
{
	display: inline-block;
	padding-top: 7dp;
	color: #e0c080;
}

#notes
{
	position: absolute;
	top: 12dp;
	right: 12dp;
	width: 360dp;
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	pointer-events: none;
}

.note
{
	margin-bottom: 6dp;
	padding: 8dp 14dp;
	border: 1dp #606060;
	border-radius: 6dp;
	background-color: #202020f0;
	font-size: 15dp;
	pointer-events: none;
}

.note.error
{
	border-color: #c06050;
	color: #f0c0b0;
}

#disk_light
{
	position: absolute;
	bottom: 12dp;
	right: 12dp;
	width: 24dp;
	height: 24dp;
	opacity: 0.75;
	pointer-events: none;
}

#disk_light img
{
	width: 24dp;
	height: 24dp;
}
