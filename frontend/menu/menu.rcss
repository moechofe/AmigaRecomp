body, div, h1, h2, p
{
	display: block;
}

body
{
	font-family: LatoLatin;
	font-size: 16dp;
	color: #e0e0e0;
	width: 100%;
	height: 100%;
}

#banner
{
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	padding: 8dp 16dp;
	background-color: #202020f0;
}

#panel
{
	position: absolute;
	top: 50%;
	left: 50%;
	width: 640dp;
	margin-left: -320dp;
	margin-top: -180dp;
	padding: 20dp;
	background-color: #202020f0;
}

h1
{
	font-size: 24dp;
	font-weight: bold;
	margin-bottom: 8dp;
}

h2
{
	font-size: 18dp;
	font-weight: bold;
	margin-bottom: 8dp;
}

.disk
{
	display: block;
	margin-bottom: 8dp;
}

.label
{
	display: inline-block;
	vertical-align: top;
	width: 100dp;
	font-weight: bold;
}

.state
{
	display: inline-block;
	vertical-align: top;
	width: 500dp;
}

.source
{
	display: block;
	margin-left: 100dp;
	font-size: 13dp;
	color: #a0a0a0;
}

p
{
	margin-top: 8dp;
}

.message
{
	color: #c0c0a0;
}

button
{
	display: inline-block;
	margin-top: 16dp;
	margin-right: 8dp;
	padding: 6dp 16dp;
	border: 1dp #808080;
	background-color: #303030;
	color: #e0e0e0;
}

button:hover
{
	background-color: #505050;
	border-color: #ffffff;
}
