body, div, h1, h2, p
{
	display: block;
}

body
{
	font-family: LatoLatin;
	font-size: 16dp;
	color: #e0e0e0;
	width: 100%;
	height: 100%;
	word-break: break-word;
}

#banner
{
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	padding: 8dp 16dp;
	background-color: #202020f0;
}

#panel
{
	position: absolute;
	top: 24dp;
	left: 50%;
	width: 640dp;
	margin-left: -320dp;
	bottom: 24dp;
	padding: 20dp;
	background-color: #202020f0;
}

h1
{
	font-size: 24dp;
	font-weight: bold;
	margin-bottom: 8dp;
}

h2
{
	font-size: 18dp;
	font-weight: bold;
	margin-top: 16dp;
	margin-bottom: 8dp;
}

.disk
{
	display: block;
	margin-bottom: 8dp;
}

.label
{
	display: inline-block;
	vertical-align: top;
	width: 100dp;
	font-weight: bold;
}

.state
{
	display: inline-block;
	vertical-align: top;
	width: 500dp;
}

.source
{
	display: block;
	margin-left: 100dp;
	font-size: 13dp;
	color: #a0a0a0;
}

p
{
	margin-top: 8dp;
}

.message
{
	color: #c0c0a0;
}

button
{
	display: inline-block;
	margin-top: 16dp;
	margin-right: 8dp;
	padding: 6dp 16dp;
	border: 1dp #808080;
	background-color: #303030;
	color: #e0e0e0;
}

button:hover
{
	background-color: #505050;
	border-color: #ffffff;
}

.option
{
	display: block;
	margin-bottom: 8dp;
}

.name
{
	display: inline-block;
	width: 420dp;
	font-weight: bold;
}

.hint
{
	display: block;
	font-size: 13dp;
	color: #a0a0a0;
}

.option.mismatch
{
	color: #808080;
}

button.chosen
{
	border-color: #ffffff;
}

.toggle
{
	display: inline-block;
}

.toggle button
{
	margin-right: 0;
	padding: 6dp 12dp;
}

.toggle button.chosen
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
}

.toggle button.chosen:hover
{
	background-color: #ffffff;
	border-color: #ffffff;
}

#head
{
	height: 72dp;
}

#head h1
{
	margin-right: 140dp;
}

#resume
{
	position: absolute;
	top: 20dp;
	right: 20dp;
	margin: 0;
	padding: 4dp 14dp;
	border-radius: 14dp;
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
}

#resume:hover
{
	background-color: #ffffff;
	border-color: #ffffff;
}

#resume .cap
{
	font-weight: bold;
	margin-right: 8dp;
}

#nav button
{
	margin-top: 0;
	margin-right: 6dp;
	padding: 4dp 14dp;
	border: 1dp #606060;
	border-radius: 14dp;
	background-color: transparent;
	color: #c0c0c0;
}

#nav button:hover
{
	border-color: #ffffff;
	color: #ffffff;
	background-color: transparent;
}

#nav button.current
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
}

#page
{
	position: absolute;
	top: 104dp;
	bottom: 20dp;
	left: 20dp;
	right: 20dp;
	padding-right: 24dp;
	overflow-y: auto;
}

scrollbarvertical
{
	width: 8dp;
}

scrollbarvertical slidertrack
{
	width: 8dp;
	background-color: #ffffff14;
	border-radius: 4dp;
}

scrollbarvertical sliderbar
{
	width: 8dp;
	min-height: 24dp;
	background-color: #ffffff60;
	border-radius: 4dp;
}

scrollbarvertical sliderbar:hover
{
	background-color: #ffffffa0;
}

.lead
{
	font-size: 18dp;
	margin-top: 0;
}

.actions
{
	display: block;
	margin-bottom: 8dp;
}

button.primary
{
	background-color: #e0e0e0;
	border-color: #e0e0e0;
	color: #181818;
	font-weight: bold;
}

button.primary:hover
{
	background-color: #ffffff;
	border-color: #ffffff;
}

.key
{
	display: block;
	margin-bottom: 4dp;
}

.disk button
{
	margin-left: 100dp;
	margin-top: 6dp;
}

.disk .hint
{
	margin-left: 100dp;
}

.drive
{
	display: block;
	margin-bottom: 8dp;
}

.drive .label
{
	padding-top: 7dp;
}

.drive .state
{
	padding-top: 7dp;
}

.drive button
{
	margin-top: 0;
}
