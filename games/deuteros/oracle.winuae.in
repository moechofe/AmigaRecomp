; AmigaRecomp oracle: WinUAE configuration template for deuteros.
; A500, Kickstart 1.3 (34.5), PAL, 512 KB chip + 512 KB slow, two floppy drives.
;
; Generated into games/deuteros/build/winuae/oracle.uae by
;   python tools/emulator.py --game deuteros --emulator winuae --df0 <Disk 1 adf> --df1 <Disk 2 adf>
; which fills @KICKSTART@, @DF0@ and @DF1@. Edit this template, never the generated copy.
; The oracle boots Disk 1 in DF0 and Disk 2 in DF1, as every measurement did.

config_description=AmigaRecomp oracle: deuteros

config_hardware=true
config_host=true

; --- CPU and chipset: period-correct unexpanded A500 -------------------------
cpu_type=68000
cpu_model=68000
cpu_speed=real
cpu_compatible=true
cpu_cycle_exact=true
cpu_24bit_addressing=true
blitter_cycle_exact=true
cycle_exact=true
chipset=ocs
chipset_compatible=A500
chipset_refreshrate=50.000000
ntsc=false
immediate_blits=false
fastmem_size=0
z3mem_size=0
rtc=none

; --- Memory: 512 KB chip + 512 KB slow --------------------------------------
; chipmem_size is in 512 KB units, bogomem_size in 256 KB units.
chipmem_size=1
bogomem_size=2

; --- Kickstart --------------------------------------------------------------
; Amiga Forever set, plain (not encrypted). md5 82a21c1890cae844b3df741f2762d48d
kickstart_rom_file=@KICKSTART@

; --- Floppies: DF0 boots, DF1 is along for the ride -------------------------
; DF1 does NOT avoid the swap prompt -- the loader only ever opens
; trackdisk.device unit 0, so the game asks for the data disk in DF0 and never
; reads DF1. It is left loaded so every dump taken so far stays comparable.
; The swap is one debugger command: I floppy0=<path>.
nr_floppies=2
floppy0type=0
floppy1type=0
floppy_speed=100
floppy0=@DF0@
floppy1=@DF1@

; --- Display: 1:1 lores, nothing that can move a pixel ----------------------
gfx_width_windowed=320
gfx_height_windowed=256
gfx_resolution=lores
gfx_linemode=none
gfx_center_horizontal=none
gfx_center_vertical=none
gfx_filter=null
gfx_filter_autoscale=none
gfx_filter_scanlines=0
gfx_fullscreen_amiga=false
gfx_vsync=false
show_leds=false

; --- Screenshots: forced 320x256, autoclip off -------------------------------
; Verified 2026-08-14: END+PrintScreen writes an exactly 320x256 24-bit PNG.
; The screenshot_mult_* keys are deliberately absent -- WinUAE 6.0.3 rejects
; the value "1" ("Unknown value") and the output is already 1:1 without them.
win32.screenshot_width=320
win32.screenshot_height=256
win32.screenshot_x=0
win32.screenshot_y=0

; --- Host events on injected keys --------------------------------------------
; NULLKEYBOARD is where SendInput-injected keys arrive, and the bindings below are
; what gives a script the host events -- screenshot, state save, state restore, warp.
; That is what they are here for, and it is why they stay.
;
; Re-measured 2026-09-24, on this same 6.0.3 binary: injected input also reaches the
; AMIGA. An injected `1` crosses the language menu to the Earth base, and injected
; relative mouse motion moves the Amiga pointer once WinUAE holds the mouse capture,
; so a click lands on an icon and navigates. Two preconditions decide it, and neither
; is in this file: the input desktop must be Default -- a running screensaver makes
; every SendInput fail with ERROR_ACCESS_DENIED -- and the emulation window must hold
; the foreground, or the keys go to whatever is focused instead. Either one on its own
; reproduces the 2026-08-16 reading that the boundary was sharp.
;
; No Amiga binding is needed for it: the key crossed the menu both with `1` bound here
; as KEY_1 and with no binding at all, so nothing below is added for the Amiga's sake.
; The capability lives in tools/capture.py -- Session.key, Session.click, `!key` and
; `!click`, --key.
;
; The button token is the decimal scancode and the key name together -- 87 is 0x57.
input.config=1
input.1.keyboard.0.friendlyname=WinUAE keyboard
input.1.keyboard.0.name=NULLKEYBOARD
input.1.keyboard.0.empty=false
input.1.keyboard.0.disabled=false
input.1.keyboard.0.button.87.F11=SPC_SCREENSHOT.0
input.1.keyboard.0.button.66.F8=SPC_STATESAVE.0
input.1.keyboard.0.button.64.F6=SPC_STATERESTORE.0
input.1.keyboard.0.button.63.F5=SPC_WARP.0

; --- Host -------------------------------------------------------------------
use_gui=no
win32.start_not_captured=true
win32.inactive_pause=false
