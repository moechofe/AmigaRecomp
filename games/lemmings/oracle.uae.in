; AmigaRecomp oracle: WinUAE configuration template for lemmings.
; A500, Kickstart 1.3 (34.5), PAL, 512 KB chip + 512 KB slow, two floppy drives.
;
; Generated into games/lemmings/build/winuae/oracle.uae by
;   python tools/emulator.py --game lemmings --df0 <Disk 1 adf> --df1 <Disk 2 adf>
; which fills @KICKSTART@, @DF0@ and @DF1@. Edit this template, never the generated copy.
; Every setting that can move a pixel is the reference machine's, as in docs/emulator.md,
; "Configuration", so shots taken here diff against the runtime's 320x256 frame.

config_description=AmigaRecomp oracle: lemmings

config_hardware=true
config_host=true

; --- CPU and chipset: period-correct unexpanded A500 -------------------------
cpu_type=68000
cpu_model=68000
cpu_speed=real
cpu_compatible=true
cpu_cycle_exact=true
cpu_24bit_addressing=true
blitter_cycle_exact=true
cycle_exact=true
chipset=ocs
chipset_compatible=A500
chipset_refreshrate=50.000000
ntsc=false
immediate_blits=false
fastmem_size=0
z3mem_size=0
rtc=none

; --- Memory: 512 KB chip + 512 KB slow --------------------------------------
; chipmem_size is in 512 KB units, bogomem_size in 256 KB units.
chipmem_size=1
bogomem_size=2

; --- Kickstart --------------------------------------------------------------
; Amiga Forever set, plain (not encrypted). md5 82a21c1890cae844b3df741f2762d48d
kickstart_rom_file=@KICKSTART@

; --- Floppies: Disk 1 boots in DF0, Disk 2 waits in DF1 ---------------------
; Whether the game reads DF1 or asks for Disk 2 in DF0 is not yet observed.
nr_floppies=2
floppy0type=0
floppy1type=0
floppy_speed=100
floppy0=@DF0@
floppy1=@DF1@

; --- Display: 1:1 lores, nothing that can move a pixel ----------------------
gfx_width_windowed=320
gfx_height_windowed=256
gfx_resolution=lores
gfx_linemode=none
gfx_center_horizontal=none
gfx_center_vertical=none
gfx_filter=null
gfx_filter_autoscale=none
gfx_filter_scanlines=0
gfx_fullscreen_amiga=false
gfx_vsync=false
show_leds=false

; --- Screenshots -------------------------------------------------------------
; The screenshot_mult_* keys are deliberately absent: WinUAE 6.0.3 rejects the
; value "1" and the output is already 1:1 without them.
win32.screenshot_width=320
win32.screenshot_height=256
win32.screenshot_x=0
win32.screenshot_y=0

; --- Host events on injected keys --------------------------------------------
; tools/capture.py injects keys with SendInput; they arrive on NULLKEYBOARD, and
; these bindings give it the host events: screenshot, state save, state restore,
; warp. The button token is the decimal scancode and the key name -- 87 is 0x57.
; F7 is the Amiga's left mouse button: an injected click reaches the Amiga only
; while WinUAE holds the mouse capture, which this config does not take. Not F10:
; Windows takes F10 into menu-bar mode and the window stops rendering.
input.config=1
input.1.keyboard.0.friendlyname=WinUAE keyboard
input.1.keyboard.0.name=NULLKEYBOARD
input.1.keyboard.0.empty=false
input.1.keyboard.0.disabled=false
input.1.keyboard.0.button.87.F11=SPC_SCREENSHOT.0
input.1.keyboard.0.button.66.F8=SPC_STATESAVE.0
input.1.keyboard.0.button.64.F6=SPC_STATERESTORE.0
input.1.keyboard.0.button.63.F5=SPC_WARP.0
input.1.keyboard.0.button.65.F7=JOY1_FIRE_BUTTON.0

; --- Host -------------------------------------------------------------------
use_gui=no
win32.start_not_captured=true
win32.inactive_pause=false
